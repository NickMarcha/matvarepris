POSTGRES_USER=matvarepris
POSTGRES_PASSWORD=matvarepris
POSTGRES_DB=matvarepris

# Cron expression for periodic catalog refresh (default: every 6 hours)
CRON_SCHEDULE=0 */6 * * *

# Run a full ingest once when the backend container starts
INGEST_ON_STARTUP=true

# Delay (ms) between each product-detail page fetch in the background
# nutrition/diet-ingredient crawler. Default is deliberately gentle
# (~1 request every 2-3s including jitter). Lower temporarily to clear an
# initial backlog faster, then raise back for steady-state.
NUTRITION_CRAWL_DELAY_MS=2000

BACKEND_PORT=4000
FRONTEND_PORT=5173
